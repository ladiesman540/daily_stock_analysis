    <array>
        <string>/Users/Uzi/Appz/finance-repos/daily_stock_analysis/.venv312/bin/python</string>
        <string>scripts/daily_snapshot.py</string>
        <string>--steps</string>
        <string>regime,portfolio,notify</string>
        <string>--alerts-only</string>
    </array>

